<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/irin/Desktop/smart-consumption-russia/data/smart_consumption.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1510"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="stm_experience" custom_title="0" dock_id="1" table="4,14:mainstm_experience"/><dock_state state="000000ff00000000fd0000000100000002000001c20000020cfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000001c20000012e00ffffff000001c20000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="consumer_confidence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="119"/><column index="2" value="104"/><column index="3" value="77"/><column index="4" value="63"/><column index="5" value="47"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="stm_experience" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="95"/><column index="2" value="95"/><column index="3" value="75"/><column index="4" value="195"/><column index="5" value="161"/><column index="6" value="82"/><column index="7" value="114"/><column index="8" value="197"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT period, regular_or_sometimes_total_pct
FROM stm_experience
ORDER BY 
    CASE period
        WHEN 'Январь 2026' THEN 1
        WHEN 'Q1 2026'     THEN 2
        WHEN 'Q2 2026'     THEN 3
        WHEN 'Май 2026'    THEN 4
        WHEN 'Июнь 2026'   THEN 5
        WHEN 'Июль 2026'   THEN 6
    END;</sql><sql name="SQL 2*">SELECT category, growth_pct_2025, growth_pct_apr_may_2026
FROM sberindex_categories
WHERE growth_pct_apr_may_2026 &lt; 0
ORDER BY growth_pct_apr_may_2026 ASC;</sql><sql name="SQL 3*">-- 1. Средний рост по группам категорий
SELECT 
    CASE 
        WHEN category LIKE 'из них:%' THEN 'подкатегория'
        ELSE category 
    END AS group_type,
    AVG(growth_pct_apr_may_2026) AS avg_growth
FROM sberindex_categories
GROUP BY group_type;</sql><sql name="SQL 6*">SELECT 
    CASE 
        WHEN category LIKE 'из них:%' THEN 'подкатегории'
        ELSE category 
    END AS group_type,
    AVG(growth_pct_apr_may_2026) AS avg_growth,
    COUNT(*) AS num_categories
FROM sberindex_categories
GROUP BY group_type
ORDER BY avg_growth DESC;</sql><sql name="SQL 4*">-- 2. Топ-5 самых быстрорастущих категорий
SELECT category, growth_pct_apr_may_2026
FROM sberindex_categories
ORDER BY growth_pct_apr_may_2026 DESC
LIMIT 5;</sql><sql name="SQL 5*">-- 3. Сравнение 2025 vs 2026: где рост ускорился
SELECT category, 
       growth_pct_2025, 
       growth_pct_apr_may_2026,
       growth_pct_apr_may_2026 - growth_pct_2025 AS acceleration
FROM sberindex_categories
ORDER BY acceleration DESC;</sql><current_tab id="3"/></tab_sql></sqlb_project>
